[Unit]
Description=Auto-start Flo Simon Says Game Docker
# Wait until the network **and** NetworkManager report "online"
After=network-online.target NetworkManager-wait-online.service docker.service graphical.target
Wants=docker.service NetworkManager-wait-online.service graphical.target

[Service]
Type=simple
User=rrl
WorkingDirectory=/home/rrl/FloSystemV2_GameDemo
ExecStart=/usr/bin/env bash /usr/local/bin/host_auto_startup_launcher.sh
Restart=on-failure
RestartSec=10

# GUI / audio env vars (unchanged)
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/rrl/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
