<include file="$(find flo_humanoid)/launch/read_write_arms.launch"/>
<node pkg="flo_humanoid" type="joint_state_to_dual_arm_motors.py"
      name="joint_state_bridge"/>
<!-- Start MoveIt -->
<include file="$(find flo_core)/launch/move_group.launch"/>
<!-- Finally, action server -->
<node pkg="flo_core" type="moveit_controller.py"/>
