<!-- flo_humanoid/launch/read_write_arms.launch -->
<launch>
  <!--   user‑tunable arguments  -->
  <arg name="port"       default="$(optenv FLO_MOTORS_DEVICE /dev/flo_motors)"/>
  <arg name="baudrate"   default="1000000"/>
  <arg name="publish_joint_states" default="false"/>

  <!--   parameters on the server  -->
  <!-- Dynamixel ID ↔︎ joint map and mechanical offsets -->
  <rosparam file="$(find flo_humanoid)/config/dynamixel_ids.yaml"/>
  <rosparam file="$(find flo_humanoid)/config/dynamixel_offsets.yaml"/>

  <param name="port"       value="$(arg port)"/>
  <param name="baudrate"   value="$(arg baudrate)" type="int"/>

  <!--   driver node itself  -->
  <node pkg="flo_humanoid"
        type="read_write_arms_node"
        name="read_write_arms_node"/>

  <!-- Only enable this in hardware-only setups that truly need this node to own /joint_states. -->
  <node pkg="joint_state_publisher"
        type="joint_state_publisher"
        name="joint_state_publisher"
        if="$(arg publish_joint_states)">
    <param name="use_gui" value="false"/>
  </node>
</launch>
