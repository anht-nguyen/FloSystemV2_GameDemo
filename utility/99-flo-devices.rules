# FLO device rules
# Generated by utility/create_udev_rules.py
# Install on the Linux host under /etc/udev/rules.d/ and reload udev.

# camera: /dev/video1
SUBSYSTEM=="video4linux", ENV{ID_SERIAL_SHORT}=="7FCD4CD0", ENV{ID_VENDOR_ID}=="046d", ENV{ID_MODEL_ID}=="082c", SYMLINK+="flo_camera"

# motors: /dev/ttyUSB0
SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="FT66WAIY", ENV{ID_VENDOR_ID}=="0403", ENV{ID_MODEL_ID}=="6014", SYMLINK+="flo_motors"

# teensy: /dev/ttyACM0
SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="17579110", ENV{ID_VENDOR_ID}=="16c0", ENV{ID_MODEL_ID}=="0483", SYMLINK+="flo_teensy"
